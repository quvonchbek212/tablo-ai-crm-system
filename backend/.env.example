# demo starts with the synthetic enterprise SQLite database.
# Set external to auto-connect the database configured below instead.
WORKSPACE_MODE=demo
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=90
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini

# To use Gemini for chat, set LLM_PROVIDER=gemini above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=90

# Any PostgreSQL database (use a database role with SELECT only)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=analytics
DB_USER=replace-with-read-only-user
DB_PASSWORD=
DB_INCLUDE_SCHEMAS=public

# Optional SSH tunnel. Keep private keys outside the repository.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PKEY_PATH=C:\Users\your-user\.ssh\tabloai_readonly
SSH_PKEY_PASSPHRASE=

# Optional legacy provider: set LLM_PROVIDER=vllm to enable.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
VLLM_MODEL=gemma4-31b
VLLM_TIMEOUT=90.0

# SQL repair limit
MAX_SQL_RETRIES=3

# Persistent schema metadata refresh interval (seconds)
SCHEMA_CACHE_TTL_SECONDS=3600
